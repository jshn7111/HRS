{
  "name": "stayease",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "build": "npm run build --workspace=stayease-client",
    "dev": "concurrently \"npm run dev --workspace=stayease-client\" \"npm run dev --workspace=stayease-server\"",
    "start": "npm run dev",
    "start:client": "npm run dev --workspace=stayease-client",
    "start:server": "npm run start --workspace=stayease-server",
    "test": "npm test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
