{
  "name": "stayease",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace client\" \"npm run dev --workspace server\"",
    "start": "npm run dev",
    "start:client": "npm run dev --workspace client",
    "start:server": "npm run start --workspace server",
    "test": "npm test --workspaces"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
